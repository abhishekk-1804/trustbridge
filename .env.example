# TrustBridge Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ==========================================
# APPLICATION SETTINGS
# ==========================================
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==========================================
# DATABASE
# ==========================================
# SQLite for development (file-based)
DATABASE_URL=sqlite:///trustbridge.db
# PostgreSQL for production (example)
# DATABASE_URL=postgresql://user:password@host:5432/trustbridge

# ==========================================
# API SERVER
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# CORS - Comma-separated origins for production
# Development defaults: http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==========================================
# AI PROVIDER (Backend-only - NEVER expose to frontend)
# ==========================================
# Choose one provider and set the corresponding API key
# Supported: openai, anthropic, google
AI_PROVIDER=openai
AI_API_KEY=YOUR_API_KEY_HERE
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=30

# Optional: Custom base URL for OpenAI-compatible APIs
# AI_BASE_URL=https://api.openai.com/v1

# ==========================================
# ML MODEL SETTINGS
# ==========================================
ML_MODEL_PATH=models/isolation_forest_model.pkl
ML_SCALER_PATH=models/feature_scaler.pkl
ML_FEATURE_COLS_PATH=models/feature_columns.pkl
ML_CONTAMINATION=0.01
ML_N_ESTIMATORS=200
ML_RANDOM_STATE=42

# ==========================================
# RISK ENGINE SETTINGS
# ==========================================
FRAUD_RULE_MULTIPLIER=3.0
TRUST_SCORE_WEIGHTS_PAYMENT_RELIABILITY=0.40
TRUST_SCORE_WEIGHTS_TRANSACTION_CONSISTENCY=0.35
TRUST_SCORE_WEIGHTS_ACCOUNT_BEHAVIOUR=0.25

# Risk thresholds
RISK_THRESHOLD_HIGH=80
RISK_THRESHOLD_MODERATE=50

# ==========================================
# PAYMENT SIMULATION
# ==========================================
DEFAULT_CURRENCY=INR
IDEMPOTENCY_KEY_PREFIX=TB_
PAYMENT_TIMEOUT_SECONDS=30

# ==========================================
# FRONTEND (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api